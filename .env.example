# Copia este archivo como .env y llena los valores.
# OJO: todo lo que empieza con VITE_ se incluye en la app y es PÚBLICO.
# Nunca pongas aquí llaves secretas (service role, access tokens, llaves de IA).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_BILLING_ENABLED=false

# ---------------------------------------------------------------
# Secretos del SERVIDOR (no van aquí): se configuran en Supabase →
# Edge Functions → Secrets, o en God Mode (se guardan en
# system_settings, que solo lee el servidor):
#   GEMINI_API_KEY, GROQ_API_KEY, OPENAI_API_KEY   (función ai-proxy)
#   APPLE_IAP_ISSUER_ID, APPLE_IAP_KEY_ID, APPLE_IAP_PRIVATE_KEY, APPLE_BUNDLE_ID  (función store-verify)
#   GOOGLE_PLAY_SERVICE_ACCOUNT, ANDROID_PACKAGE                                  (función store-verify)
# ---------------------------------------------------------------
