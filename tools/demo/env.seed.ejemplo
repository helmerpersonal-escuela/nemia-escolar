# Copia este archivo a la raíz del proyecto con el nombre  .env.seed  y llena los valores.
# .env.seed NO se sube a GitHub (está en .gitignore). Nunca lo pongas en Vercel ni en la app.

# Candado: los scripts solo trabajan si esto dice exactamente "development".
NODE_ENV=development

# Supabase → Project Settings → API
SUPABASE_URL=
# La llave "service_role" (secreta). Solo para estos scripts en tu computadora.
SUPABASE_SERVICE_ROLE_KEY=
